# Copy this file to .env (cp .env.example .env) and put your OpenAI API key
# after the "=". Samantha reads .env from the directory you run in and from
# your program's project root. A real environment variable with the same name
# wins over this file. Never commit .env (.gitignore lists it).
OPENAI_API_KEY=

# Optional settings (see docs/GUIDE.md):
# SAMANTHA_MODEL=gpt-5.6-terra
# SAMANTHA=act
